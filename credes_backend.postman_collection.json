    {
      "name": "Webhook Examples",
      "item": [
        {
          "name": "POST Telegram Webhook",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Telegram-Bot-Api-Secret-Token",
                "value": "{{telegramWebhookSecret}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"update_id\": 123456789,\n  \"message\": {\n    \"message_id\": 100,\n    \"from\": {\n      \"id\": 111111,\n      \"is_bot\": false,\n      \"first_name\": \"Test\"\n    },\n    \"chat\": {\n      \"id\": 111111,\n      \"type\": \"private\"\n    },\n    \"date\": 1714464000,\n    \"text\": \"/start user-id\"\n  }\n}"
            },
            "url": "{{baseUrl}}/api/bot/telegram/webhook/{{telegramWebhookSecret}}"
          },
          "response": [
            {
              "name": "200 OK",
              "originalRequest": {
                "method": "POST",
                "url": "{{baseUrl}}/api/bot/telegram/webhook/secret"
              },
              "status": "OK",
              "code": 200,
              "body": "{\n  \"success\": true\n}"
            }
          ]
        },
        {
          "name": "POST WhatsApp Twilio Webhook",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
              {
                "key": "X-Twilio-Signature",
                "value": "<twilio-signature>"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "MessageSid",
                  "value": "SMXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX",
                  "type": "text"
                },
                {
                  "key": "ProfileName",
                  "value": "Test User",
                  "type": "text"
                },
                {
                  "key": "WaId",
                  "value": "919999999999",
                  "type": "text"
                },
                {
                  "key": "Timestamp",
                  "value": "Thu, 30 Apr 2026 08:00:00 +0000",
                  "type": "text"
                },
                {
                  "key": "From",
                  "value": "whatsapp:+919999999999",
                  "type": "text"
                },
                {
                  "key": "Body",
                  "value": "/start user-id",
                  "type": "text"
                }
              ]
            },
            "url": "{{baseUrl}}/webhooks/whatsapp/twilio"
          },
          "response": [
            {
              "name": "200 OK",
              "originalRequest": {
                "method": "POST",
                "url": "{{baseUrl}}/webhooks/whatsapp/twilio"
              },
              "status": "OK",
              "code": 200,
              "body": "{\n  \"success\": true\n}"
            }
          ]
        }
      ]
