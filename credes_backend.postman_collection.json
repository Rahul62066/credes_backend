    {
      "name": "OAuth APIs",
      "item": [
        {
          "name": "GET OAuth Connect (:platform)",
          "request": {
            "method": "GET",
            "header": [],
            "description": "Set {{platform}} to twitter, linkedin, or meta.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/api/oauth/{{platform}}/connect"
          },
          "response": [
            {
              "name": "302 Redirect",
              "originalRequest": {
                "method": "GET",
                "url": "{{baseUrl}}/api/oauth/twitter/connect"
              },
              "status": "Found",
              "code": 302,
              "header": [
                {
                  "key": "Location",
                  "value": "https://provider.example.com/oauth/authorize?..."
                }
              ],
              "body": ""
            }
          ]
        },
        {
          "name": "GET OAuth Callback (:platform)",
          "request": {
            "method": "GET",
            "header": [],
            "description": "Used by provider redirect. In Postman, set {{platform}}, {{oauthCode}}, and {{oauthState}} manually.",
            "url": "{{baseUrl}}/api/oauth/{{platform}}/callback?code={{oauthCode}}&state={{oauthState}}"
          },
          "response": [
            {
              "name": "200 HTML Success",
              "originalRequest": {
                "method": "GET",
                "url": "{{baseUrl}}/api/oauth/linkedin/callback?code=abc123&state=state123"
