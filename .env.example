# .env.example — Credes backend
# Copy to `.env` for local development. Marked variables are REQUIRED or OPTIONAL.

# ----------------------- Required for local development -----------------------
# Server
NODE_ENV=development
PORT=5000
# Start BullMQ workers in this process (set true only for the background worker service)
RUN_WORKERS=false

# Database (PostgreSQL) - required in most environments
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postly_db?schema=public"

# Redis (used for sessions, tokens, queues)
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT secrets (required)
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Encryption (AES-256-GCM) — REQUIRED for encrypting sensitive fields
# Generate 32-byte key using:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# TELEGRAM (bot + webhook) — set these to enable Telegram integration
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
# Toggle verifying Telegram webhook secret header (use `true` in production)
TELEGRAM_VERIFY_WEBHOOK=false

# Twilio (WhatsApp) — optional (only if using WhatsApp integration)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# WhatsApp From number in format: whatsapp:+1234567890
TWILIO_WHATSAPP_FROM=
TWILIO_WEBHOOK_URL=
# Toggle verifying Twilio webhook signatures (use `true` in production)
TWILIO_VERIFY_WEBHOOK=false

# ----------------------- Optional / Fallback / Provider keys -----------------
# AI provider keys (used as fallbacks by code)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Social publisher API base URLs (only change if using custom endpoints)
TWITTER_API_BASE_URL=https://api.twitter.com
LINKEDIN_API_BASE_URL=https://api.linkedin.com
META_API_BASE_URL=https://graph.facebook.com
META_API_VERSION=v19.0

# OAuth provider credentials (optional; required for enabling OAuth flows)
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_REDIRECT_URI=https://example.com/api/oauth/twitter/callback

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://example.com/api/oauth/linkedin/callback

META_CLIENT_ID=
META_CLIENT_SECRET=
META_REDIRECT_URI=https://example.com/api/oauth/meta/callback

# BullMQ prefix (queues)
BULL_QUEUE_PREFIX=postly

# CORS
CORS_ORIGIN=http://localhost:3000

# App base URL (used for callbacks, links). Optional but useful.
APP_BASE_URL=http://localhost:5000

# Rate limiting defaults (seconds)
RATE_LIMIT_CONTENT_WINDOW_SECONDS=900
RATE_LIMIT_CONTENT_MAX=10
RATE_LIMIT_PUBLISH_WINDOW_SECONDS=3600
RATE_LIMIT_PUBLISH_MAX=20

# Misc: API versions / toggles
TWITTER_API_BASE_URL=https://api.twitter.com

# ----------------------- Notes -----------------------------------------------
# Which variables are REQUIRED for local development:
# - DATABASE_URL
# - REDIS_HOST, REDIS_PORT (or REDIS_URL if you use one)
# - JWT_ACCESS_SECRET, JWT_REFRESH_SECRET
# - ENCRYPTION_KEY
# - TELEGRAM_* keys only if you plan to test Telegram locally

# Which variables are OPTIONAL:
# - OPENAI_API_KEY, ANTHROPIC_API_KEY, OPENROUTER_API_KEY (only if using AI providers)
# - TWILIO_* (only if using WhatsApp integration)
# - OAuth provider client IDs/secrets (only if enabling OAuth)
