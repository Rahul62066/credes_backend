# ─── Server ──────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── Database (PostgreSQL) ───────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postly_db?schema=public"

# ─── Redis ───────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── JWT ─────────────────────────────────────────────
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# ─── Encryption (AES-256-GCM) ───────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ─── BullMQ ─────────────────────────────────────────
BULL_QUEUE_PREFIX=postly

# ─── CORS ───────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000
