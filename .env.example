# ─── Server ──────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── Database (PostgreSQL) ───────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postly_db?schema=public"
# ─── Redis ───────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── JWT ─────────────────────────────────────────────
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# ─── Encryption (AES-256-GCM) ───────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ─── AI API Keys (platform fallback) ────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ─── Social Publisher API Base URLs (optional) ──────
TWITTER_API_BASE_URL=https://api.twitter.com
LINKEDIN_API_BASE_URL=https://api.linkedin.com
META_API_BASE_URL=https://graph.facebook.com
META_API_VERSION=v19.0

# ─── BullMQ ─────────────────────────────────────────
BULL_QUEUE_PREFIX=postly

# ─── CORS ───────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
# Verify Telegram webhook header? Set to true in production to require header check
TELEGRAM_VERIFY_WEBHOOK=false

APP_BASE_URL=https://credes-backend-1g52.onrender.com

# Twilio WhatsApp (optional)
# Get these from your Twilio console: https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# WhatsApp From number in format: whatsapp:+1234567890
TWILIO_WHATSAPP_FROM=
# Webhook base URL for Twilio callbacks (no path) e.g., https://your-app.onrender.com
TWILIO_WEBHOOK_URL=
# Verify Twilio webhook signatures? Set to false for local dev
TWILIO_VERIFY_WEBHOOK=true

# Rate limiting (seconds)
# Content generation: default 15 minutes window, 10 requests
RATE_LIMIT_CONTENT_WINDOW_SECONDS=900
RATE_LIMIT_CONTENT_MAX=10

# Publishing: default 1 hour window, 20 requests
RATE_LIMIT_PUBLISH_WINDOW_SECONDS=3600
RATE_LIMIT_PUBLISH_MAX=20

# OAuth providers
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_REDIRECT_URI=https://credes-backend-1g52.onrender.com/api/oauth/twitter/callback

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://credes-backend-1g52.onrender.com/api/oauth/linkedin/callback

META_CLIENT_ID=
META_CLIENT_SECRET=
META_REDIRECT_URI=https://credes-backend-1g52.onrender.com/api/oauth/meta/callback