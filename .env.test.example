NODE_ENV=test
PORT=5001

# PostgreSQL test database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postly_test

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_ACCESS_SECRET=test_access_secret_change_me
JWT_REFRESH_SECRET=test_refresh_secret_change_me
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Encryption (32-byte key)
ENCRYPTION_KEY=12345678901234567890123456789012

# AI fallback keys (not used by mocked tests but required by env contract)
OPENAI_API_KEY=test-openai-key
ANTHROPIC_API_KEY=test-anthropic-key

# Social APIs
TWITTER_API_BASE_URL=https://api.twitter.com
LINKEDIN_API_BASE_URL=https://api.linkedin.com

# Queue
BULL_QUEUE_PREFIX=postly_test

# CORS
CORS_ORIGIN=http://localhost:3000

# Telegram
TELEGRAM_BOT_TOKEN=test-telegram-token
TELEGRAM_WEBHOOK_URL=https://example.com
TELEGRAM_WEBHOOK_SECRET=test-webhook-secret
